---
const nav = [
  { label: 'What we do', href: '#what-we-do' },
  { label: 'Use cases', href: '#use-cases' },
  { label: 'Technology', href: '#technology' },
  { label: 'How we work', href: '#how-we-work' }
];

const useCases = [
  ['Sales', 'Sales Assistants', 'Prospecting, account research, opportunity preparation and follow-up.'],
  ['Service', 'Service Agents', 'Case assistance, knowledge, resolution and intelligent escalation.'],
  ['Contact Center', 'Contact Center Agents', 'Customer interaction, agent assistance and next-best action.'],
  ['Self-Service', 'Customer Agents', 'Answers, orders, status, product information and service requests.'],
  ['Knowledge', 'Knowledge Assistants', 'Find, explain and apply business knowledge across systems.'],
  ['Healthcare', 'Patient Assistants', 'Patient navigation, education, scheduling and staff assistance.'],
  ['Operations', 'Operations Agents', 'Workflow orchestration, data retrieval, approvals and exceptions.'],
  ['New Business', 'Agentic Businesses', 'New products, services and business models designed around autonomous Agents.']
];

const steps = [
  ['01', 'Discover', 'Understand the business, the users, the opportunity and the outcome.'],
  ['02', 'Design', 'Shape the Agent, actions, data, guardrails and human escalation.'],
  ['03', 'Build', 'Use AI-native engineering to turn the design into a working solution.'],
  ['04', 'Deploy', 'Pilot or move into production with a bounded, governed scope.'],
  ['05', 'Prove', 'Measure adoption, acceptance and business impact, then expand.']
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="TELTECH Agentic Workforce — Human Leadership. Agentic Execution. AI Agentic consulting, projects and incubation for growing companies." />
  <meta name="theme-color" content="#0B2545" />
  <title>TELTECH | Agentic Workforce</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="TELTECH home">
      <img class="brand-logo" src="data:image/webp;base64," alt="TELTECH Agentic Workforce" />
    </a>
    <nav aria-label="Primary navigation">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href="#start">Start Discovery <span>↗</span></a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">TELTECH AGENTIC WORKFORCE</p>
        <h1>Human Leadership.<br /><em>Agentic Execution.</em></h1>
        <p class="hero-sub">Multiply your workforce.<br />Not your overhead.</p>
        <p class="hero-text">We help small and midsize companies transform business processes and create new businesses with autonomous AI Agents — with people setting the direction and Agents doing the work.</p>
        <div class="hero-actions">
          <a class="button primary" href="#start">Discover an opportunity <span>→</span></a>
          <a class="button secondary" href="#what-we-do">See what we build</a>
        </div>
      </div>

      <div class="workforce-diagram" aria-label="Human leadership and Agentic execution diagram">
        <div class="diagram-label top">HUMAN LEADERSHIP</div>
        <div class="human-core"><strong>PEOPLE</strong><span>Strategy · Judgment · Priorities · Governance</span></div>
        <div class="connector"></div>
        <div class="agent-ring">
          <div class="ring-title">AGENTIC WORKFORCE</div>
          <div class="agent agent-one">Sales<br /><small>Agent</small></div>
          <div class="agent agent-two">Service<br /><small>Agent</small></div>
          <div class="agent agent-three">Knowledge<br /><small>Agent</small></div>
          <div class="agent agent-four">Operations<br /><small>Agent</small></div>
          <div class="agent-center">AI<br />AGENTS</div>
        </div>
        <div class="diagram-result">BUSINESS EXECUTION<br /><strong>More capacity · Faster work · New possibilities</strong></div>
      </div>
    </section>

    <section id="what-we-do" class="section intro">
      <div class="section-heading">
        <p class="eyebrow">TWO WAYS TO BUILD WITH TELTECH</p>
        <h2>Transform the business you have.<br /><em>Create the business that comes next.</em></h2>
      </div>
      <div class="two-offers">
        <article class="offer">
          <span class="offer-number">01</span>
          <p class="offer-kicker">AGENTIC PROJECTS</p>
          <h3>Transform the work you already do.</h3>
          <p>We discover business processes, workflows and customer journeys where autonomous Agents can create measurable value.</p>
          <a href="#use-cases">Explore projects <span>→</span></a>
        </article>
        <article class="offer featured">
          <span class="offer-number">02</span>
          <p class="offer-kicker">AGENTIC INCUBATION</p>
          <h3>Create what was not practical before.</h3>
          <p>We help shape new products, services and business models designed around autonomous Agents from the beginning.</p>
          <a href="#start">Explore an idea <span>→</span></a>
        </article>
      </div>
    </section>

    <section class="section value">
      <div class="section-heading narrow">
        <p class="eyebrow">WHAT VALUE WE PROVIDE</p>
        <h2>AI Agents do the work.<br /><em>People lead the workforce.</em></h2>
      </div>
      <div class="value-grid">
        <article><b>01</b><h3>More capacity</h3><p>Agents take on repeatable digital work so people can focus on decisions, relationships and exceptions.</p></article>
        <article><b>02</b><h3>Faster execution</h3><p>Agents can retrieve information, reason over context and take governed actions across business systems.</p></article>
        <article><b>03</b><h3>Better experiences</h3><p>Customers and employees can get intelligent assistance where work actually happens.</p></article>
        <article><b>04</b><h3>New possibilities</h3><p>Agentic technology can make new products, services and operating models practical.</p></article>
      </div>
    </section>

    <section id="use-cases" class="section usecases">
      <div class="section-heading">
        <p class="eyebrow">BUSINESS PROCESSES & WORKFLOWS</p>
        <h2>Where can an Agent<br /><em>do meaningful work?</em></h2>
        <p>We focus on concrete business situations rather than technology for its own sake.</p>
      </div>
      <div class="usecase-grid">
        {useCases.map(([area, title, text], index) => (
          <article class="usecase">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <small>{area}</small>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section experience">
      <div class="experience-copy">
        <p class="eyebrow">COMPLEX BUSINESS ENVIRONMENTS</p>
        <h2>Agentic solutions for the realities of <em>real business.</em></h2>
        <p>Our project thinking is shaped by complex organizations and industries where customer experience, operations, data, compliance and scale matter.</p>
      </div>
      <div class="experience-cloud">
        <span>Insurance</span><span>Healthcare</span><span>Energy</span><span>Telecommunications</span><span>Financial Services</span><span>Agriculture</span><span>Technology</span><span>Events</span>
        <p>Relevant environments include organizations such as Aon, Syngenta, British Petroleum, Sanofi Pasteur, Schlumberger, RSA, PAR, Telefónica, Movistar, FLAR and Corferias.</p>
      </div>
    </section>

    <section id="technology" class="section technology">
      <div class="section-heading">
        <p class="eyebrow">OUR TECHNOLOGY ECOSYSTEM</p>
        <h2>The platforms.<br /><em>The Agents. The integration.</em></h2>
      </div>
      <div class="tech-map">
        <div class="tech-center">TELTECH<br /><small>AGENTIC WORKFORCE</small></div>
        <div class="tech-card t1"><strong>Salesforce</strong><span>Agentforce · Data 360 · CRM</span></div>
        <div class="tech-card t2"><strong>HubSpot</strong><span>CRM · Marketing · Sales · Service</span></div>
        <div class="tech-card t3"><strong>AI</strong><span>Claude · ChatGPT · AI-native engineering</span></div>
        <div class="tech-card t4"><strong>Integration</strong><span>APIs · MCP · Agentic interoperability</span></div>
      </div>
    </section>

    <section id="how-we-work" class="section method">
      <div class="section-heading">
        <p class="eyebrow">HOW WE WORK</p>
        <h2>Discover. Design. Build.<br /><em>Deploy. Prove.</em></h2>
      </div>
      <div class="steps">
        {steps.map(([number, title, text]) => <article class="step"><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}
      </div>
      <div class="human-principle">
        <div class="principle-diagram"><div>HUMANS</div><span>set direction</span><b>↕</b><div>AI AGENTS</div><span>execute work</span></div>
        <div><p class="eyebrow">THE TELTECH PRINCIPLE</p><h3>Humans in the hat.<br /><em>AI Agents at work.</em></h3><p>People retain vision, judgment, governance and responsibility. Agents handle repeatable digital work within clear boundaries.</p></div>
      </div>
    </section>

    <section id="start" class="section start">
      <div class="section-heading">
        <p class="eyebrow">START DISCOVERY</p>
        <h2>There is more than one way<br /><em>to start with an Agent.</em></h2>
        <p>Choose the path that fits you. We can make the first interaction Agentic from the beginning.</p>
      </div>
      <div class="start-grid">
        <a class="start-card" href="mailto:info@teltechsas.com?subject=Talk to a TelTech Agent"><span>01</span><h3>Talk to an Agent now</h3><p>Start an immediate conversation about a business challenge or idea.</p><b>Start →</b></a>
        <a class="start-card" href="mailto:info@teltechsas.com?subject=TelTech Discovery Information"><span>02</span><h3>Send us information</h3><p>Share your company, process, challenge or idea and let the Agent begin discovery.</p><b>Send information →</b></a>
        <a class="start-card" href="mailto:info@teltechsas.com?subject=Schedule TelTech Discovery"><span>03</span><h3>Schedule a conversation</h3><p>Choose a time to explore the opportunity with a TelTech specialist.</p><b>Schedule →</b></a>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-brand"><strong>TELTECH</strong><span>Agentic Workforce</span></div>
    <p>Human Leadership. Agentic Execution.</p>
    <p>© 2026 TelTech. All rights reserved.</p>
  </footer>
</body>
</html>

<style>
:root{--navy:#0B2545;--teal:#2A9D8F;--aqua:#7FD1C9;--sand:#F4E6D7;--slate:#687280;--off:#FAFAF8;--ink:#132238;--line:#dfe6e7}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--off);color:var(--ink);font-family:Inter,system-ui,sans-serif}a{text-decoration:none;color:inherit}.site-header{height:92px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:20;background:rgba(250,250,248,.94);backdrop-filter:blur(14px);border-bottom:1px solid rgba(11,37,69,.08)}.brand{display:flex;align-items:center}.brand-logo{display:block;width:270px;height:auto;max-height:66px;object-fit:contain;object-position:left center}nav{display:flex;gap:28px;font-size:13px;color:#445467}nav a:hover{color:var(--teal)}.header-cta{font-size:12px;font-weight:700;color:var(--navy);border-bottom:1px solid var(--teal);padding:9px 0}.hero{min-height:calc(100vh - 92px);padding:75px 7vw 95px;display:grid;grid-template-columns:1fr 1fr;gap:5vw;align-items:center;background:linear-gradient(115deg,#fbfcfa 25%,#f2f8f5 100%);overflow:hidden}.eyebrow{font-size:10px;letter-spacing:.2em;font-weight:700;color:var(--teal);margin:0 0 20px}.hero h1,h2,h3{font-family:Lora,Georgia,serif}.hero h1{font-size:clamp(48px,5.7vw,82px);line-height:.98;letter-spacing:-.04em;margin:0;color:var(--navy)}h1 em,h2 em,h3 em{font-style:normal;color:var(--teal)}.hero-sub{font-family:Lora,Georgia,serif;font-size:clamp(23px,2.4vw,31px);line-height:1.15;color:var(--navy);margin:30px 0 16px}.hero-text{font-size:17px;line-height:1.75;color:#536273;max-width:650px}.hero-actions{display:flex;gap:13px;margin-top:32px}.button{display:inline-flex;align-items:center;gap:20px;border-radius:999px;padding:15px 21px;font-size:12px;font-weight:700}.button.primary{background:var(--navy);color:white}.button.primary:hover{background:var(--teal)}.button.secondary{border:1px solid #cbd7d8;color:var(--navy)}.workforce-diagram{min-height:600px;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-start}.diagram-label{font-size:10px;letter-spacing:.2em;font-weight:700;color:var(--teal);margin-bottom:12px}.human-core{width:240px;height:110px;border:2px solid var(--teal);border-radius:24px;background:rgba(255,255,255,.82);display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 15px 45px rgba(11,37,69,.09);z-index:2}.human-core strong{font-family:Lora,serif;font-size:22px;color:var(--navy)}.human-core span{font-size:10px;color:var(--slate);margin-top:7px;text-align:center}.connector{height:48px;width:1px;background:linear-gradient(var(--teal),var(--aqua))}.agent-ring{width:420px;height:420px;border:1px solid rgba(42,157,143,.35);border-radius:50%;position:relative;background:radial-gradient(circle,rgba(127,209,201,.2),transparent 62%);box-shadow:inset 0 0 70px rgba(127,209,201,.08)}.ring-title{position:absolute;top:30px;left:0;right:0;text-align:center;font-size:9px;letter-spacing:.18em;color:var(--slate);font-weight:700}.agent{position:absolute;width:86px;height:86px;border-radius:50%;display:flex;align-items:center;justify-content:center;text-align:center;background:white;border:1px solid rgba(11,37,69,.13);box-shadow:0 12px 30px rgba(11,37,69,.09);font-size:12px;font-weight:700;color:var(--navy)}.agent small{font-size:9px;color:var(--teal)}.agent-one{left:30px;top:90px}.agent-two{right:30px;top:90px}.agent-three{left:65px;bottom:62px}.agent-four{right:65px;bottom:62px}.agent-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:128px;height:128px;border-radius:50%;background:var(--navy);color:white;display:flex;align-items:center;justify-content:center;text-align:center;font-family:Lora,serif;font-size:20px;line-height:1.05;box-shadow:0 20px 45px rgba(11,37,69,.2)}.diagram-result{text-align:center;margin-top:22px;color:var(--navy);font-size:10px;letter-spacing:.16em;font-weight:700}.diagram-result strong{display:block;font-size:10px;color:var(--slate);letter-spacing:.03em;margin-top:7px}.section{padding:115px 7vw}.intro{background:white}.section-heading{max-width:850px}.section-heading.narrow{max-width:700px}.section-heading h2{font-size:clamp(38px,4.4vw,62px);line-height:1.04;letter-spacing:-.035em;margin:0;color:var(--navy)}.section-heading>p:last-child{font-size:17px;line-height:1.75;color:var(--slate);max-width:680px;margin-top:23px}.two-offers{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:58px}.offer{padding:40px;border:1px solid var(--line);border-radius:24px;background:var(--off);position:relative}.offer.featured{background:var(--navy);color:white;border-color:var(--navy)}.offer-number{font-size:11px;color:var(--teal);font-weight:700}.offer-kicker{font-size:10px;letter-spacing:.18em;font-weight:700;color:var(--teal);margin:25px 0 12px}.offer h3{font-size:28px;line-height:1.15;color:var(--navy);margin:0 0 15px}.featured h3{color:white}.offer p:not(.offer-kicker){font-size:15px;line-height:1.7;color:var(--slate);max-width:580px}.featured p:not(.offer-kicker){color:#c3d1d8}.offer a{display:inline-flex;gap:12px;margin-top:18px;font-size:12px;font-weight:700;color:var(--navy)}.featured a{color:var(--aqua)}.value{background:#f5f7f5}.value-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:55px}.value-grid article{padding:28px;border-top:2px solid var(--teal);background:white}.value-grid b{font-size:10px;color:var(--teal)}.value-grid h3{font-size:21px;color:var(--navy);margin:28px 0 9px}.value-grid p{font-size:14px;line-height:1.65;color:var(--slate);margin:0}.usecases{background:white}.usecase-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin-top:60px;background:#d8e2e1}.usecase{padding:27px;background:#fbfcfa;min-height:205px}.usecase>span{font-size:10px;color:var(--teal);font-weight:700}.usecase small{display:block;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate);margin-top:20px}.usecase h3{font-size:20px;color:var(--navy);margin:7px 0 10px}.usecase p{font-size:13px;line-height:1.6;color:var(--slate);margin:0}.experience{display:grid;grid-template-columns:1fr 1fr;gap:8vw;background:var(--sand);align-items:center}.experience-copy h2{font-size:clamp(36px,4vw,56px);line-height:1.05;color:var(--navy);margin:0}.experience-copy>p:last-child{font-size:16px;line-height:1.75;color:#596978;max-width:580px}.experience-cloud{display:flex;flex-wrap:wrap;gap:10px}.experience-cloud span{padding:11px 15px;border-radius:999px;background:rgba(255,255,255,.6);color:var(--navy);font-size:12px;font-weight:600}.experience-cloud p{width:100%;font-size:12px;line-height:1.65;color:#687280;margin-top:22px}.technology{background:#f5f7f5}.tech-map{height:480px;max-width:980px;margin:55px auto 0;position:relative}.tech-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:180px;height:180px;border-radius:50%;background:var(--navy);color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;font-family:Lora,serif;font-size:25px;line-height:1}.tech-center small{font:600 7px Inter,sans-serif;letter-spacing:.18em;color:var(--aqua);margin-top:10px}.tech-card{position:absolute;width:280px;padding:23px;background:white;border:1px solid var(--line);border-radius:20px;box-shadow:0 14px 35px rgba(11,37,69,.07)}.tech-card strong{display:block;font-family:Lora,serif;font-size:22px;color:var(--navy)}.tech-card span{display:block;font-size:12px;color:var(--slate);margin-top:8px;line-height:1.5}.t1{left:0;top:25px}.t2{right:0;top:25px}.t3{left:0;bottom:25px}.t4{right:0;bottom:25px}.method{background:var(--navy);color:white}.method .eyebrow{color:var(--aqua)}.method .section-heading h2{color:white}.steps{display:grid;grid-template-columns:repeat(5,1fr);margin-top:60px;gap:1px;background:rgba(255,255,255,.16)}.step{background:var(--navy);padding:27px;min-height:230px}.step>span{font-size:10px;color:var(--aqua);letter-spacing:.15em}.step h3{font-size:21px;color:white;margin:52px 0 11px}.step p{font-size:13px;line-height:1.6;color:#b8c7d0;margin:0}.human-principle{margin-top:75px;padding:45px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:center}.principle-diagram{text-align:center}.principle-diagram div{display:inline-block;padding:14px 22px;border:1px solid var(--aqua);border-radius:999px;font-size:11px;letter-spacing:.1em}.principle-diagram span{display:block;font-size:11px;color:#b8c7d0;margin:8px 0}.principle-diagram b{display:block;color:var(--aqua);font-size:20px}.human-principle h3{font-size:36px;color:white;line-height:1.1;margin:0}.human-principle p:last-child{font-size:15px;line-height:1.7;color:#b8c7d0}.start{background:white}.start-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:58px}.start-card{padding:34px;border:1px solid var(--line);border-radius:22px;background:var(--off);transition:transform .2s,box-shadow .2s}.start-card:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(11,37,69,.09)}.start-card>span{font-size:10px;color:var(--teal);font-weight:700}.start-card h3{font-size:24px;color:var(--navy);margin:30px 0 10px}.start-card p{font-size:14px;line-height:1.65;color:var(--slate);min-height:70px}.start-card b{font-size:12px;color:var(--navy)}footer{background:#071b33;color:#b5c2cc;padding:35px 7vw;display:flex;align-items:center;justify-content:space-between;font-size:11px}footer p{margin:0}.footer-brand{display:flex;align-items:baseline;gap:12px;color:white}.footer-brand strong{font-size:18px;letter-spacing:.08em}.footer-brand span{color:var(--aqua);letter-spacing:.08em;font-size:9px;text-transform:uppercase}@media(max-width:1000px){nav{display:none}.hero,.experience{grid-template-columns:1fr}.workforce-diagram{margin-top:20px}.value-grid,.usecase-grid{grid-template-columns:repeat(2,1fr)}.steps{grid-template-columns:1fr 1fr}.start-grid{grid-template-columns:1fr}.tech-map{height:650px}.t1,.t2{top:20px}.t3,.t4{bottom:20px}.t1,.t3{left:0}.t2,.t4{right:0}}@media(max-width:700px){.site-header{height:78px;padding:0 5vw}.brand-logo{width:205px}.header-cta{font-size:10px}.hero{padding:60px 7vw}.hero h1{font-size:48px}.hero-actions{flex-direction:column;align-items:flex-start}.workforce-diagram{min-height:510px}.agent-ring{width:310px;height:310px}.agent{width:68px;height:68px;font-size:10px}.agent-one{left:15px}.agent-two{right:15px}.agent-three{left:40px;bottom:40px}.agent-four{right:40px;bottom:40px}.agent-center{width:100px;height:100px;font-size:16px}.two-offers,.human-principle{grid-template-columns:1fr}.value-grid,.usecase-grid,.steps{grid-template-columns:1fr}.tech-map{height:850px}.tech-center{top:50%}.tech-card{width:100%;left:0!important;right:auto!important}.t1{top:0}.t2{top:160px}.t3{bottom:160px}.t4{bottom:0}.section{padding:85px 7vw}.section-heading h2{font-size:40px}.experience-cloud{margin-top:15px}footer{flex-direction:column;align-items:flex-start;gap:12px}}
</style>