---
const nav = [
  { label: 'What we do', href: '#what-we-do' },
  { label: 'Use cases', href: '#use-cases' },
  { label: 'Technology', href: '#technology' },
  { label: 'How we work', href: '#how-we-work' }
];

const useCases = [
  ['Sales', 'Sales Assistants', 'Prospecting, account research, opportunity preparation and follow-up.'],
  ['Service', 'Service Agents', 'Case assistance, knowledge, resolution and intelligent escalation.'],
  ['Contact Center', 'Contact Center Agents', 'Customer interaction, agent assistance and next-best action.'],
  ['Self-Service', 'Customer Agents', 'Answers, orders, status, product information and service requests.'],
  ['Knowledge', 'Knowledge Assistants', 'Find, explain and apply business knowledge across systems.'],
  ['Healthcare', 'Patient Assistants', 'Patient navigation, education, scheduling and staff assistance.'],
  ['Operations', 'Operations Agents', 'Workflow orchestration, data retrieval, approvals and exceptions.'],
  ['New Business', 'Agentic Businesses', 'New products, services and business models designed around autonomous Agents.']
];

const steps = [
  ['01', 'Discover', 'Understand the business, the users, the opportunity and the outcome.'],
  ['02', 'Design', 'Shape the Agent, actions, data, guardrails and human escalation.'],
  ['03', 'Build', 'Use AI-native engineering to turn the design into a working solution.'],
  ['04', 'Deploy', 'Pilot or move into production with a bounded, governed scope.'],
  ['05', 'Prove', 'Measure adoption, acceptance and business impact, then expand.']
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="TELTECH Agentic Workforce — Human Leadership. Agentic Execution. AI Agentic consulting, projects and incubation for growing companies." />
  <meta name="theme-color" content="#0B2545" />
  <title>TELTECH | Agentic Workforce</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="TELTECH home">
      <img class="brand-logo" src="/teltech_Logo.png" alt="TELTECH Agentic Workforce" />
    </a>
    <nav aria-label="Primary navigation">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href="#start">Start Discovery <span>↗</span></a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">TELTECH AGENTIC WORKFORCE</p>
        <h1>Human Leadership.<br /><em>Agentic Execution.</em></h1>
        <p class="hero-sub">Multiply your workforce.<br />Not your overhead.</p>
        <p class="hero-text">We help small and midsize companies transform business processes and create new businesses with autonomous AI Agents — with people setting the direction and Agents doing the work.</p>
        <div class="hero-actions">
          <a class="button primary" href="#start">Discover an opportunity <span>→</span></a>
          <a class="button secondary" href="#what-we-do">See what we build</a>
        </div>
      </div>

      <div class="workforce-diagram" aria-label="TelTech Agentic Workforce diagram">
        <svg class="workforce-svg" viewBox="0 0 1389 1132" role="img" aria-label="Humans set the direction. AI Agents do the work.">
          <defs>
            <radialGradient id="glow"><stop offset="0" stop-color="#7FD1C9" stop-opacity=".23"/><stop offset=".72" stop-color="#7FD1C9" stop-opacity=".04"/><stop offset="1" stop-color="#7FD1C9" stop-opacity="0"/></radialGradient>
            <linearGradient id="humanBg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FAFAF8"/><stop offset="1" stop-color="#EEF7F4"/></linearGradient>
            <linearGradient id="agentBg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#EAF8F6"/><stop offset="1" stop-color="#FAFAF8"/></linearGradient>
            <linearGradient id="actionBg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#F4E6D7"/><stop offset="1" stop-color="#FAF2E8"/></linearGradient>
          </defs>
          <ellipse cx="700" cy="560" rx="590" ry="330" fill="url(#glow)"/>
          <ellipse cx="700" cy="560" rx="585" ry="320" fill="none" stroke="#7FD1C9" stroke-opacity=".42" stroke-width="2"/>
          <ellipse cx="700" cy="560" rx="650" ry="390" fill="none" stroke="#7FD1C9" stroke-opacity=".30" stroke-width="2" transform="rotate(-20 700 560)"/>
          <ellipse cx="700" cy="560" rx="455" ry="505" fill="none" stroke="#7FD1C9" stroke-opacity=".28" stroke-width="2" transform="rotate(62 700 560)"/>

          <!-- Human / Direction -->
          <g transform="translate(45 345)">
            <circle cx="115" cy="115" r="113" fill="url(#humanBg)" stroke="#2A9D8F" stroke-width="4"/>
            <text x="115" y="107" text-anchor="middle" font-family="Inter,sans-serif" font-size="28" font-weight="700" fill="#0B2545">Human</text>
            <text x="115" y="143" text-anchor="middle" font-family="Inter,sans-serif" font-size="22" fill="#687280">Direction</text>
          </g>

          <!-- Friendly AI Agents / Execution -->
          <g transform="translate(955 195)">
            <circle cx="115" cy="115" r="113" fill="url(#agentBg)" stroke="#0B2545" stroke-width="3"/>
            <g transform="translate(38 28)">
              <rect x="47" y="20" width="60" height="50" rx="18" fill="#FAFAF8" stroke="#2A9D8F" stroke-width="3"/>
              <circle cx="66" cy="43" r="5.5" fill="#2A9D8F"/><circle cx="88" cy="43" r="5.5" fill="#2A9D8F"/>
              <path d="M66 56 Q77 64 88 56" fill="none" stroke="#0B2545" stroke-width="3" stroke-linecap="round"/>
              <path d="M77 20 V9" stroke="#2A9D8F" stroke-width="3"/><circle cx="77" cy="6" r="4" fill="#7FD1C9"/>
              <rect x="4" y="49" width="31" height="27" rx="10" fill="#FAFAF8" stroke="#7FD1C9" stroke-width="2.5"/>
              <circle cx="14" cy="62" r="3" fill="#2A9D8F"/><circle cx="25" cy="62" r="3" fill="#2A9D8F"/>
              <rect x="119" y="47" width="31" height="27" rx="10" fill="#FAFAF8" stroke="#7FD1C9" stroke-width="2.5"/>
              <circle cx="129" cy="60" r="3" fill="#2A9D8F"/><circle cx="140" cy="60" r="3" fill="#2A9D8F"/>
              <path d="M56 70 L51 91 M99 70 L104 91" stroke="#0B2545" stroke-width="4" stroke-linecap="round"/>
            </g>
            <text x="115" y="180" text-anchor="middle" font-family="Inter,sans-serif" font-size="26" font-weight="700" fill="#0B2545">AI Agents</text>
            <text x="115" y="214" text-anchor="middle" font-family="Inter,sans-serif" font-size="22" fill="#687280">Execution</text>
          </g>

          <!-- Data / Context -->
          <g transform="translate(420 830)">
            <circle cx="115" cy="115" r="113" fill="#FAFAF8" stroke="#D9E1E2" stroke-width="2.5"/>
            <path d="M42 137 C78 85 104 160 132 111 S178 83 190 126" fill="none" stroke="#7FD1C9" stroke-width="10" stroke-linecap="round"/>
            <path d="M42 155 C82 112 106 164 136 130 S180 109 192 144" fill="none" stroke="#2A9D8F" stroke-width="4" stroke-linecap="round"/>
            <text x="115" y="184" text-anchor="middle" font-family="Inter,sans-serif" font-size="26" font-weight="700" fill="#0B2545">Data</text>
            <text x="115" y="218" text-anchor="middle" font-family="Inter,sans-serif" font-size="22" fill="#687280">Context</text>
          </g>

          <!-- Actions / Impact -->
          <g transform="translate(835 660)">
            <circle cx="115" cy="115" r="113" fill="url(#actionBg)" stroke="#D8C5B2" stroke-width="2.5"/>
            <circle cx="163" cy="58" r="16" fill="#E8B873"/>
            <path d="M54 150 C92 96 132 108 170 70" fill="none" stroke="#C6A47D" stroke-width="10" stroke-linecap="round"/>
            <path d="M54 166 C94 125 134 132 173 94" fill="none" stroke="#F7CFA8" stroke-width="7" stroke-linecap="round"/>
            <text x="115" y="184" text-anchor="middle" font-family="Inter,sans-serif" font-size="26" font-weight="700" fill="#0B2545">Actions</text>
            <text x="115" y="218" text-anchor="middle" font-family="Inter,sans-serif" font-size="22" fill="#687280">Impact</text>
          </g>

          <!-- Core message -->
          <g transform="translate(700 535)">
            <text x="0" y="0" text-anchor="middle" font-family="Inter,sans-serif" font-size="21" letter-spacing="4" fill="#687280">PEOPLE SET THE DIRECTION.</text>
            <text x="0" y="38" text-anchor="middle" font-family="Inter,sans-serif" font-size="22" font-weight="700" letter-spacing="2" fill="#0B2545">AGENTS MAKE IT HAPPEN.</text>
          </g>
        </svg>
      </div>
    </section>   </section>   </section>

    <section id="what-we-do" class="section intro">
      <div class="section-heading">
        <p class="eyebrow">TWO WAYS TO BUILD WITH TELTECH</p>
        <h2>Transform the business you have.<br /><em>Create the business that comes next.</em></h2>
      </div>
      <div class="two-offers">
        <article class="offer">
          <span class="offer-number">01</span>
          <p class="offer-kicker">AGENTIC PROJECTS</p>
          <h3>Transform the work you already do.</h3>
          <p>We discover business processes, workflows and customer journeys where autonomous Agents can create measurable value.</p>
          <a href="#use-cases">Explore projects <span>→</span></a>
        </article>
        <article class="offer featured">
          <span class="offer-number">02</span>
          <p class="offer-kicker">AGENTIC INCUBATION</p>
          <h3>Create what was not practical before.</h3>
          <p>We help shape new products, services and business models designed around autonomous Agents from the beginning.</p>
          <a href="#start">Explore an idea <span>→</span></a>
        </article>
      </div>
    </section>

    <section class="section value">
      <div class="section-heading narrow">
        <p class="eyebrow">WHAT VALUE WE PROVIDE</p>
        <h2>AI Agents do the work.<br /><em>People lead the workforce.</em></h2>
      </div>
      <div class="value-grid">
        <article><b>01</b><h3>More capacity</h3><p>Agents take on repeatable digital work so people can focus on decisions, relationships and exceptions.</p></article>
        <article><b>02</b><h3>Faster execution</h3><p>Agents can retrieve information, reason over context and take governed actions across business systems.</p></article>
        <article><b>03</b><h3>Better experiences</h3><p>Customers and employees can get intelligent assistance where work actually happens.</p></article>
        <article><b>04</b><h3>New possibilities</h3><p>Agentic technology can make new products, services and operating models practical.</p></article>
      </div>
    </section>

    <section id="use-cases" class="section usecases">
      <div class="section-heading">
        <p class="eyebrow">BUSINESS PROCESSES & WORKFLOWS</p>
        <h2>Where can an Agent<br /><em>do meaningful work?</em></h2>
        <p>We focus on concrete business situations rather than technology for its own sake.</p>
      </div>
      <div class="usecase-grid">
        {useCases.map(([area, title, text], index) => (
          <article class="usecase">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <small>{area}</small>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section experience">
      <div class="experience-copy">
        <p class="eyebrow">COMPLEX BUSINESS ENVIRONMENTS</p>
        <h2>Agentic solutions for the realities of <em>real business.</em></h2>
        <p>Our project thinking is shaped by complex organizations and industries where customer experience, operations, data, compliance and scale matter.</p>
      </div>
      <div class="experience-cloud">
        <span>Insurance</span><span>Healthcare</span><span>Energy</span><span>Telecommunications</span><span>Financial Services</span><span>Agriculture</span><span>Technology</span><span>Events</span>
        <p>Relevant environments include organizations such as Aon, Syngenta, British Petroleum, Sanofi Pasteur, Schlumberger, RSA, PAR, Telefónica, Movistar, FLAR and Corferias.</p>
      </div>
    </section>

    <section id="technology" class="section technology">
      <div class="section-heading">
        <p class="eyebrow">OUR TECHNOLOGY ECOSYSTEM</p>
        <h2>The platforms.<br /><em>The Agents. The integration.</em></h2>
      </div>
      <div class="tech-map">
        <div class="tech-center">TELTECH<br /><small>AGENTIC WORKFORCE</small></div>
        <div class="tech-card t1"><strong>Salesforce</strong><span>Agentforce · Data 360 · CRM</span></div>
        <div class="tech-card t2"><strong>HubSpot</strong><span>CRM · Marketing · Sales · Service</span></div>
        <div class="tech-card t3"><strong>AI</strong><span>Claude · ChatGPT · AI-native engineering</span></div>
        <div class="tech-card t4"><strong>Integration</strong><span>APIs · MCP · Agentic interoperability</span></div>
      </div>
    </section>

    <section id="how-we-work" class="section method">
      <div class="section-heading">
        <p class="eyebrow">HOW WE WORK</p>
        <h2>Discover. Design. Build.<br /><em>Deploy. Prove.</em></h2>
      </div>
      <div class="steps">
        {steps.map(([number, title, text]) => <article class="step"><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}
      </div>
      <div class="human-principle">
        <div class="principle-diagram"><div>HUMANS</div><span>set direction</span><b>↕</b><div>AI AGENTS</div><span>execute work</span></div>
        <div><p class="eyebrow">THE TELTECH PRINCIPLE</p><h3>Humans in the hat.<br /><em>AI Agents at work.</em></h3><p>People retain vision, judgment, governance and responsibility. Agents handle repeatable digital work within clear boundaries.</p></div>
      </div>
    </section>

    <section id="start" class="section start">
      <div class="section-heading">
        <p class="eyebrow">START DISCOVERY</p>
        <h2>There is more than one way<br /><em>to start with an Agent.</em></h2>
        <p>Choose the path that fits you. We can make the first interaction Agentic from the beginning.</p>
      </div>
      <div class="start-grid">
        <a class="start-card" href="mailto:info@teltechsas.com?subject=Talk to a TelTech Agent"><span>01</span><h3>Talk to an Agent now</h3><p>Start an immediate conversation about a business challenge or idea.</p><b>Start →</b></a>
        <a class="start-card" href="mailto:info@teltechsas.com?subject=TelTech Discovery Information"><span>02</span><h3>Send us information</h3><p>Share your company, process, challenge or idea and let the Agent begin discovery.</p><b>Send information →</b></a>
        <a class="start-card" href="mailto:info@teltechsas.com?subject=Schedule TelTech Discovery"><span>03</span><h3>Schedule a conversation</h3><p>Choose a time to explore the opportunity with a TelTech specialist.</p><b>Schedule →</b></a>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-brand"><strong>TELTECH</strong><span>Agentic Workforce</span></div>
    <p>Human Leadership. Agentic Execution.</p>
    <p>© 2026 TelTech. All rights reserved.</p>
  </footer>
</body>
</html>

<style>
:root{--navy:#0B2545;--teal:#2A9D8F;--aqua:#7FD1C9;--sand:#F4E6D7;--slate:#687280;--off:#FAFAF8;--ink:#132238;--line:#dfe6e7;--font-display:"Lora",serif;--font-body:"Inter",sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--off);color:var(--ink);font-family:var(--font-body);font-synthesis:none}a{text-decoration:none;color:inherit}.site-header{height:92px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:20;background:rgba(250,250,248,.94);backdrop-filter:blur(14px);border-bottom:1px solid rgba(11,37,69,.08)}.brand{display:flex;align-items:center}.brand-logo{display:block;width:270px;height:auto;max-height:66px;object-fit:contain;object-position:left center}nav{display:flex;gap:28px;font-size:13px;color:#445467}nav a:hover{color:var(--teal)}.header-cta{font-size:12px;font-weight:700;color:var(--navy);border-bottom:1px solid var(--teal);padding:9px 0}.hero{min-height:calc(100vh - 92px);padding:75px 7vw 95px;display:grid;grid-template-columns:1fr 1fr;gap:5vw;align-items:center;background:linear-gradient(115deg,#fbfcfa 25%,#f2f8f5 100%);overflow:hidden}.eyebrow{font-size:10px;letter-spacing:.2em;font-weight:700;color:var(--teal);margin:0 0 20px}.hero h1,h2,h3{font-family:var(--font-display);font-weight:700}.hero h1{font-size:clamp(48px,5.7vw,82px);line-height:.98;letter-spacing:-.04em;margin:0;color:var(--navy)}h1 em,h2 em,h3 em{font-style:normal;color:var(--teal)}.hero-sub{font-family:var(--font-display);font-weight:600;font-size:clamp(23px,2.4vw,31px);line-height:1.15;color:var(--navy);margin:30px 0 16px}.hero-text{font-size:17px;line-height:1.75;color:#536273;max-width:650px}.hero-actions{display:flex;gap:13px;margin-top:32px}.button{display:inline-flex;align-items:center;gap:20px;border-radius:999px;padding:15px 21px;font-size:12px;font-weight:700}.button.primary{background:var(--navy);color:white}.button.primary:hover{background:var(--teal)}.button.secondary{border:1px solid #cbd7d8;color:var(--navy)}.workforce-diagram{min-height:650px;position:relative;overflow:visible;display:flex;align-items:center;justify-content:center}.workforce-svg{width:100